# PostgreSQL
POSTGRES_DB=pedsonco
POSTGRES_USER=pedsonco
POSTGRES_PASSWORD=change_me_postgres

# FastAPI database URL inside Docker Compose
DATABASE_URL=postgresql+psycopg://pedsonco:change_me_postgres@postgres:5432/pedsonco

# MinIO / S3-compatible storage
# Internal endpoint is used by FastAPI inside Docker.
S3_ENDPOINT_URL=http://minio:9000
# Public endpoint is embedded into presigned URLs and MUST be reachable by the browser.
# Local Docker Desktop: http://localhost:9000
# Production example: https://storage.example.org
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=pedsonco_minio
S3_SECRET_KEY=change_me_minio
S3_BUCKET=pedsonco-uploads
S3_REGION=us-east-1
PRESIGN_EXPIRES_SECONDS=3600
MAX_URL_IMPORT_BYTES=5368709120

# Allowed browser origins for FastAPI + MinIO bucket CORS.
WEB_ORIGINS=http://localhost:8080,http://localhost:5173

# Browser-facing development API. Production React uses same-origin /api via Nginx.
VITE_API_BASE_URL=http://localhost:8000/api
